# Service
APP_NAME=document-parsing-service
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# MySQL 8 (all relational/account/billing data)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=document_parsing_app
MYSQL_PASSWORD=replace-with-doc-only-password
MYSQL_DATABASE=document_parsing
MYSQL_UNIX_SOCKET=/var/run/mysqld/mysqld.sock
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
# Legacy SQLite is used only by scripts/migrate_sqlite_to_mysql.py.
SQLITE_SOURCE_PATH=data/app.db
BOOTSTRAP_ADMIN_EMAIL=admin@doc.zhouyuaninfo.com.cn
BOOTSTRAP_ADMIN_PASSWORD=change-this-password

# SMS
APP_SMS_ENABLED=false
APP_SMS_PROVIDER=tencent
APP_SMS_SECRET_ID=replace-with-secret-id
APP_SMS_SECRET_KEY=replace-with-secret-key
APP_SMS_SDK_APP_ID=replace-with-sdk-app-id
APP_SMS_SIGN_NAME=replace-with-sign-name
APP_SMS_TEMPLATE_ID=replace-with-template-id
APP_SMS_CODE_EXPIRE_SECONDS=300
APP_SMS_DAILY_PHONE_LIMIT=10
APP_SMS_HOURLY_IP_LIMIT=30
APP_SMS_WRONG_LOCK_SECONDS=900

# Ark / Doubao
ARK_API_KEY=replace-with-your-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION_MODEL=doubao-vision-pro-32k
DOUBAO_EMBEDDING_MODEL=doubao-embedding
DOUBAO_CHAT_MODEL=doubao-pro-32k
VISION_MAX_RETRIES=3
VISION_TIMEOUT_SECONDS=60
VISION_TEMPERATURE=0.1
VISION_MAX_TOKENS=2048
VISION_QPS=1
VISION_PROMPT_TEMPLATE=请将这张图片中的寄存器描述或参数表格转换为纯文本表格，仅输出结果，不要解释。

# Qdrant (local default)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=manual_chunks
VECTOR_SIZE=1024
DISTANCE_METRIC=Cosine

# Chunking / RAG answer
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RAG_ANSWER_MAX_TOKENS=1200
